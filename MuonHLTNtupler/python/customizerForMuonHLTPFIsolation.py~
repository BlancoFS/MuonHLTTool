            + process.hltL3crIsoL1TkSingleMu22L3f24QL3pfecalIsoFiltered0p41
            + process.hltL3crIsoL1TkSingleMu22L3f24QL3pfhcalIsoFiltered0p40 
            + process.hltL3crIsoL1TkSingleMu22L3f24QL3pfhgcalIsoFiltered4p70
